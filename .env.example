# Generate secrets with: python3 scripts/generate_env.py
PUBLIC_URL=http://192.168.1.100:4000
POSTGRES_PASSWORD=
ADMIN_PASSWORD=
SECRET_KEY_BASE=
TOKEN_ENCRYPTION_KEY=
RENDERER_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/callback
GOOGLE_BROWSER_ORIGIN=http://localhost:4000

# LAN binding and stable Compose project name
BIND_ADDRESS=0.0.0.0
PORT=4000
COMPOSE_PROJECT_NAME=trmnl

# Optional preschool menu summaries (OpenRouter free models only)
OPENROUTER_API_KEY=
